# Copy to .env. Values below work with `docker compose up -d db` + `npm run dev`.
DATABASE_URL=postgres://fdr:fdr@localhost:5432/fdr
TEST_DATABASE_URL=postgres://fdr:fdr@localhost:5432/fdr_test
JWT_SECRET=change-me-to-a-long-random-string
MOCK_BANK_URL=http://localhost:4000
STORAGE_DIR=./storage
TZ=Asia/Kolkata
PORT=3000
DEMO_MODE=true
# mock bank behaviour
MOCK_BANK_PORT=4000
MOCK_BANK_OFFLINE_BANKS=Indian Overseas Bank
MOCK_BANK_SLOW_BANKS=Bank of India
MOCK_BANK_SLOW_SECONDS=10
# frontend
VITE_API_URL=http://localhost:3000/api/v1
