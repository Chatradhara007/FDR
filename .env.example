# Copy to .env. Values below work with `docker compose up -d db` + `npm run dev`.
DATABASE_URL=postgres://fdr:fdr@localhost:55432/fdr
TEST_DATABASE_URL=postgres://fdr:fdr@localhost:55432/fdr_test
# Host port docker-compose publishes Postgres on (default 5432). Must match the port in the URLs above.
# DB_HOST_PORT=5432
JWT_SECRET=change-me-to-a-long-random-string
MOCK_BANK_URL=http://localhost:4000
STORAGE_DIR=./storage
TZ=Asia/Kolkata
PORT=3000
DEMO_MODE=true
# SHOWCASE_MODE=true: the preloaded product build. No demo ribbon, demo tools or scenario wording; every /demo/*
# endpoint returns 403 (the audit tamper demonstration and its undo only if DEMO_MODE=true as well); the sample
# data is seeded once on first start when the database has no instruments, never again; the app clock moves
# from Admin > App clock. Startup refuses SHOWCASE_MODE=true with the placeholder JWT_SECRET above or without
# FILE_ENCRYPTION_KEY. Generate both (docs/DEPLOY.md):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"                     -> JWT_SECRET
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"  -> FILE_ENCRYPTION_KEY
SHOWCASE_MODE=false
# Documents at rest (AES-256-GCM), 32 random bytes base64. Optional only with DEMO_MODE=true and SHOWCASE_MODE off.
# FILE_ENCRYPTION_KEY=
# Production image only: the built frontend served from the API's origin (docker/prod/Dockerfile sets it).
# STATIC_DIR=
# Where a release order's QR code points (the portal's public address).
# PUBLIC_BASE_URL=
# mock bank behaviour
MOCK_BANK_PORT=4000
MOCK_BANK_OFFLINE_BANKS=Indian Overseas Bank
MOCK_BANK_SLOW_BANKS=Bank of India
MOCK_BANK_SLOW_SECONDS=10
# frontend
VITE_API_URL=http://localhost:3000/api/v1
